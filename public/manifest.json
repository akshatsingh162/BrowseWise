{
  "manifest_version": 3,
  "name": "BrowseWise",
  "version": "0.1.0",
  "description": "Privacy-first screen-time tracking for Chrome. All data stays on your device.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "BrowseWise",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "tabs", "idle", "alarms", "favicon"]
}
